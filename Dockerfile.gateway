# syntax=docker/dockerfile:1

FROM golang:1.26.4-bookworm AS build

ARG TARGETOS=linux
ARG TARGETARCH

WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH:-$(go env GOARCH)} go build -trimpath -ldflags='-s -w' \
	-o /out/cnpg-test-gateway ./cmd/cnpg-test-gateway

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /out/cnpg-test-gateway /cnpg-test-gateway
USER 65532:65532
ENTRYPOINT ["/cnpg-test-gateway"]
